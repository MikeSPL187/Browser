+package dev.sk2andy.materialbrowser.browser
+
+/**
+ * The top-level domains a typed address can end in: what separates `example.com` (a site) from
+ * `file.txt`, `node.js` or `Dr.Who` (words with a dot, which are searches). Without it every word
+ * that ends in two letters after a dot opened `https://<word>` and ended on a «couldn't find»
+ * page.
+ *
+ * [ROOT_ZONE_SOURCE] holds the Latin ones of the IANA root zone, from the npm package `tlds` 1.261.0
+ * (October 2025). The international ones (`.рф`, `.中国`) are not listed: they reach
+ * [AddressResolver] in punycode, as `xn--…`, and every such label is accepted there. A top-level
+ * domain newer than the list is searched for instead of opened, and the person can still type
+ * `https://` in front of it. To refresh the list, run `npm pack tlds`, keep the entries of
+ * `index.json` that match `^[a-z]{2,}$` and replace the lines below; `KnownTopLevelDomainsTest`
+ * checks that they stay sorted and unique.
+ *
+ * Names that home and office networks use but IANA does not delegate (`router.local`, `nas.lan`)
+ * are in [LOCAL_USE]: they are opened too.
+ */
+internal object KnownTopLevelDomains {
+    /** True for a delegated top-level domain or one of the names networks use among themselves. */
+    fun contains(label: String): Boolean {
+        val lower = label.lowercase()
+        return lower in ROOT_ZONE || lower in LOCAL_USE
+    }
+
+    /** The root-zone entries in the order they are written, for the test that keeps them sorted. */
+    internal fun rootZoneInOrder(): List<String> = ROOT_ZONE_LIST
+
+    /** Reserved or conventional names of private networks and documentation, never searched for. */
+    private val LOCAL_USE = setOf(
+        "local", "localhost", "lan", "home", "internal", "intranet", "private", "corp", "localdomain",
+        "test", "example", "invalid",
+    )
+
+    private val ROOT_ZONE_LIST: List<String> = ROOT_ZONE_SOURCE.trim().split(Regex("\\s+"))
+
+    private val ROOT_ZONE: Set<String> = ROOT_ZONE_LIST.toHashSet()
+}
