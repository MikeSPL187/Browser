<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <!-- Cloud backup carries only the user's own configuration files. Shared preferences stay
         out: they also hold open tabs, history, favorites, site exceptions and sync credentials,
         which must not leave the device without an explicit export. -->
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="candy_filter_rules.json" />
        <include domain="file" path="candy_filter_rules.json.bak" />
        <include domain="file" path="user_scripts.json" />
        <include domain="file" path="user_scripts.json.bak" />
        <include domain="file" path="site_capsules_v1.json" />
        <include domain="file" path="site_capsules_v1.json.bak" />
        <include domain="file" path="site_capsule_icons" />
    </cloud-backup>
    <device-transfer>
        <!-- no_backup is intentionally outside this allowlist; Recall stays device-local. -->
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
        <include domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
