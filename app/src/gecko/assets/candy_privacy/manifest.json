{
  "manifest_version": 2,
  "name": "Vola Privacy Host",
  "version": "1.5.67",
  "browser_specific_settings": {
    "gecko": {
      "id": "candy-privacy-host@sk2andy.dev"
    }
  },
  "background": {
    "scripts": ["rules.js", "host_blocker.js", "network_blocker.js", "privacy_signals.js", "animation_policy.js", "background.js"]
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content_top_inset_bridge.js", "text_input_occlusion.js", "content_top_inset.js", "content_safe_area_reddit.js", "content_safe_area_prototype.js", "content_site_color.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["privacy_signals.js", "animation_policy.js", "dom_probe.js", "login_field_focus.js", "content.js", "tap_highlight.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "permissions": [
    "geckoViewAddons",
    "nativeMessaging",
    "privacy",
    "webRequest",
    "webRequestBlocking",
    "<all_urls>"
  ]
}
