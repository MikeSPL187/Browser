a.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,194][525,283]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[176,381][904,1134]"><node index="0" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="What?" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,381][888,418]"><node index="0" text="What?" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,383][269,416]" /></node><node index="1" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,440][888,522]"><node index="0" text='This website is for when you try to open Facebook, Google, Amazon, etc on a wifi network, and nothing happens. Type "http://neverssl.com" into your browser&apos;s url bar, and you&apos;ll be able to log on.' resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,444][872,519]" /></node><node index="2" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="How?" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,555][888,591]"><node index="0" text="How?" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,556][261,589]" /></node><node index="3" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,613][888,695]"><node index="0" text="neverssl.com will never use SSL (also known as TLS). No encryption, no strong authentication, no " resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,617][788,665]" /><node index="1" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="HSTS" checkable="false" checked="false" clickable="true" enabled="true" focusable="true" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[333,644][375,665]"><node index="0" text="HSTS" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[333,644][375,665]" /></node><node index="2" text=", no HTTP/2.0, just plain old unencrypted HTTP and forever stuck in the dark ages of internet security." resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,644][885,692]" /></node><node index="4" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="Why?" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,728][888,764]"><node index="0" text="Why?" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,729][259,762]" /></node><node index="5" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,786][888,841]"><node index="0" text="Normally, that's a bad idea. You should always use SSL and secure encryption when possible. In fact, it's such a bad idea that most websites are now using https by default." resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,790][853,838]" /></node><node index="6" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,858][888,1022]"><node index="0" text="And that's great, but it also means that if you're relying on poorly-behaved wifi networks, it can be hard to get online. Secure browsers and websites using https make it impossible for those wifi networks to send you to a login or payment page. Basically, those networks can't tap into your connection just like attackers can't. Modern browsers are so good that they can remember when a website supports encryption and even if you type in the website name, they'll use https." resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,862][882,1019]" /></node><node index="7" text="" resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" password="false" selected="false" bounds="[192,1040][888,1094]"><node index="0" text="And if the network never redirects you to this page, well as you can see, you're not missing much." resource-id="" class="android.view.View" package="io.github.mikespl187.vola.debug" content-desc="" checkable="false" checked="false" clickable="false" enabled="true" focusable="false" focused="false" scrollable="false" long-clickable="false" 